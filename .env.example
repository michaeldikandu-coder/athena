# ---------------------------------------------------------------
# Athena API server (apps/api). Copy to .env in the repo root.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Public URL of the API (used to display webhook URLs)
API_URL=http://localhost:3001
# Dashboard origin(s) allowed to call the API and open WebSockets (comma separated)
CORS_ORIGINS=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/athena

# Auth. Use a random value of 32+ characters in production: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Set to "none" when dashboard and API are on different sites (needs HTTPS)
COOKIE_SAMESITE=lax
# Set to false to stop new sign-ups
ALLOW_REGISTRATION=true

# Secret used to derive per-workflow webhook signing secrets
WEBHOOK_SIGNING_SECRET=change-me

# ---------------- LLM providers (at least one) ----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Adaptive thinking effort: low | medium | high | xhigh | max. ANTHROPIC_THINKING=off for older models
ANTHROPIC_EFFORT=medium
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Default provider for app installs: anthropic | groq
LLM_PROVIDER=anthropic
MAX_CONCURRENT_EXECUTIONS=5

# ---------------- User connections ----------------
# Each user connects their own Bachs key, GitHub token and repo, Slack webhook
# and monitored services in the dashboard (Build > Connections). They are
# stored encrypted with this key. 32+ random characters: openssl rand -hex 32
# Changing it later makes stored credentials unreadable (users reconnect).
ENCRYPTION_KEY=change-me
# OpsGuard health checks may reach private/localhost addresses. Default: allowed
# outside production, refused in production. Set true or false to override.
OPSGUARD_ALLOW_PRIVATE_URLS=

# ---------------- Server-level app settings (optional) ----------------
# Override the Bachs API base URL for every user
BACHS_BASE_URL=
# Large-payment thresholds per currency in major units (defaults cover USD, NGN, GHS, KES, ZAR, ...)
MONEYGUARD_LARGE_AMOUNTS={"NGN":"1500000","USD":"1000"}
# Log files on this server OpsGuard may read, by name. Only these paths are readable.
OPSGUARD_LOG_FILES={}

LOG_LEVEL=info

# ---------------------------------------------------------------
# Dashboard (apps/dashboard). These are read at BUILD time.
# ---------------------------------------------------------------
# Where the dashboard proxies /api/* (server-side)
API_INTERNAL_URL=http://localhost:3001
# WebSocket URL the browser connects to
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
