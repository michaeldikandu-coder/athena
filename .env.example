# ---------------------------------------------------------------
# Athena API server (apps/api). Copy to .env in the repo root.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Public URL of the API (used to display webhook URLs)
API_URL=http://localhost:3001
# Dashboard origin(s) allowed to call the API and open WebSockets (comma separated)
CORS_ORIGINS=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/athena

# Auth. Use a random value of 32+ characters in production: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Set to "none" when dashboard and API are on different sites (needs HTTPS)
COOKIE_SAMESITE=lax
# Set to false to stop new sign-ups
ALLOW_REGISTRATION=true

# Secret used to derive per-workflow webhook signing secrets
WEBHOOK_SIGNING_SECRET=change-me

# ---------------- LLM providers (at least one) ----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Adaptive thinking effort: low | medium | high | xhigh | max. ANTHROPIC_THINKING=off for older models
ANTHROPIC_EFFORT=medium
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Default provider for app installs: anthropic | groq
LLM_PROVIDER=anthropic
MAX_CONCURRENT_EXECUTIONS=5

# ---------------- MoneyGuard ----------------
# Stripe secret key. A test-mode key (sk_test_...) uses the real Stripe API with test data.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at <API_URL>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Large-charge threshold in minor units (100000 = 1,000.00)
MONEYGUARD_LARGE_AMOUNT=100000

# ---------------- OpsGuard ----------------
# Services to health-check. The agent can only reach URLs listed here.
OPSGUARD_SERVICES=[{"name":"api","url":"https://api.example.com/health"}]
# Log files the agent may read, by name. Only these paths are readable.
OPSGUARD_LOG_FILES={}
# GitHub token with Issues (read/write) and Actions (read/write) on GITHUB_REPO
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
# Extra repos agents may use (comma separated)
GITHUB_ALLOWED_REPOS=
# Secret of the repository webhook pointing at <API_URL>/api/webhooks/github
GITHUB_WEBHOOK_SECRET=

# ---------------- Shared ----------------
# Slack incoming webhook used by the send_notification tool
SLACK_WEBHOOK_URL=

LOG_LEVEL=info

# ---------------------------------------------------------------
# Dashboard (apps/dashboard). These are read at BUILD time.
# ---------------------------------------------------------------
# Where the dashboard proxies /api/* (server-side)
API_INTERNAL_URL=http://localhost:3001
# WebSocket URL the browser connects to
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
